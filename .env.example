# Copy to .env for local runs (never commit .env). In GitHub Actions these
# are set as repository secrets instead (see .github/workflows/*.yml).

# Supabase project (Settings -> API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# football-data.org, free tier: 10 requests/minute, current season included
FOOTBALL_DATA_API_KEY=your-football-data-org-key
# FOOTBALL_DATA_BASE_URL=https://api.football-data.org/v4

# Google Gemini (aistudio.google.com/apikey) -- free tier, no credit card
# needed. Used to extract player/club names and the official/rumor flag
# from news headlines (see src/news/llmExtract.js). Regex fallback kicks in
# automatically if this is missing/fails, but real extraction quality
# needs this key set.
GEMINI_API_KEY=your-gemini-api-key
# GEMINI_MODEL=gemini-3.5-flash-lite

# Web Push VAPID keypair (generate once with:
# node -e "console.log(require('web-push').generateVAPIDKeys())")
# -- entirely free, no paid push service involved (rides on Apple/Google's
# own push infrastructure). VAPID_PUBLIC_KEY must exactly match the
# frontend's VITE_VAPID_PUBLIC_KEY (web/.env.example). Missing/invalid keys
# just skip sending push notifications, doesn't fail the scrape run.
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
# VAPID_SUBJECT=https://kick-radar-eosin.vercel.app

# Fixtures sync now always fetches the whole current season in one call
# (football-data.org's /competitions/:id/matches returns everything when
# no date range is given) -- no window size to configure here anymore.

# GOAL API (goal-api.com) -- lineups, match events (goals/cards/subs),
# and live in-play data. Free plan: 1000 req/day, 1 concurrent WebSocket
# connection with up to 25 match subscriptions -- confirmed live, no
# credit card needed. Get a free key at goal-api.com's dashboard.
# GOAL_API_KEY=your-goal-api-key

# Optional overrides if the guessed default feed/selector for a news source
# turns out to be wrong once checked against the live site:
# TUTTOMERCATOWEB_RSS_URL=
# KICKER_RSS_URL=
# SKYSPORTS_SITEMAP_URL=
# RMCSPORT_LIST_URL=
# RMCSPORT_ITEM_SELECTOR=
# RMCSPORT_TITLE_SELECTOR=
# RMCSPORT_LINK_SELECTOR=
