# Copy to .env for local runs (never commit .env). In GitHub Actions these
# are set as repository secrets instead (see .github/workflows/*.yml).

# Supabase project (Settings -> API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# API-Football (api-sports.io), free plan: 100 requests/day
API_FOOTBALL_KEY=your-api-football-key
# API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io

# How many days ahead to sync fixtures for (default 21)
# FIXTURE_WINDOW_DAYS=21

# Optional overrides if the guessed default feed/selector for a news source
# turns out to be wrong once checked against the live site:
# TUTTOMERCATOWEB_RSS_URL=
# KICKER_RSS_URL=
# SKYSPORTS_RSS_URL=
# RMCSPORT_LIST_URL=
# RMCSPORT_ITEM_SELECTOR=
# RMCSPORT_TITLE_SELECTOR=
# RMCSPORT_LINK_SELECTOR=
