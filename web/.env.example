# Copy to .env for local dev (never commit .env). These are the
# publishable/anon key values, safe to ship to the browser -- NOT the
# service_role key used by the backend scripts.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# Web Push public key (safe to ship to the browser -- it's the "public"
# half of the VAPID keypair, the private half stays backend-only). Must
# match the backend's VAPID_PUBLIC_KEY exactly.
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key
